<!-- ============================================================ -->
<!-- SECTION 8: CAMPAIGN ROADMAP -->
<!-- ============================================================ -->
<div class="page-break"></div>

<p class="section-tag">Section 8</p>
<h2>Campaign Roadmap</h2>

<p>A phased approach building momentum toward measurable results over four months.</p>

<table class="bordered">
<thead>
<tr>
<th style="width: 18%;">Phase</th>
<th style="width: 18%;">Timeline</th>
<th style="width: 22%;">Focus</th>
<th style="width: 42%;">Key Activities</th>
